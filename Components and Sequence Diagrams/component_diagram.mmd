%% Component Diagram for Youth Account Management (Mermaid)
flowchart TD
    subgraph WebApp [Banking Web Application]
      UI[Parent Dashboard UI (React)]
      API[Youth Account Management API (Spring Boot REST)]
      DB[Youth Account DB (PostgreSQL)]
    end
    
    UI -- REST --> API
    API -- JDBC --> DB
    API -- HTTPS --> AccountService[Account Service]
    API -- HTTPS --> TransactionService[Transaction Service]
    API -- HTTPS --> PaymentService[Payment Service]
    
    classDef external fill:#eee,stroke:#888,stroke-width:2px;
    AccountService,TransactionService,PaymentService class external;
    
    %% Compliance & Security overlays
    note for API: "OAuth2, RBAC, Audit Logging, GDPR, PCI-DSS, ISO 27001"
    note for UI: "RBAC, Input Validation"
    note for DB: "Encrypted, Backups, DR"
    
    %% Traceability
    UI ---|SCIB-26, SCIB-28, SCIB-29| API
    API ---|SCIB-26, SCIB-27, SCIB-28, SCIB-29| DB
    DB ---|SCIB-28| DB
    