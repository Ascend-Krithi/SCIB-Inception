%% Component Diagram for Youth Account Management Solution
%% C4 style Mermaid diagram
flowchart TD
    subgraph WebApp [Banking Web Application]
        UI[Parent Portal UI (React SPA)]
        API[Youth Account API (Spring Boot REST API)]
        DB[Youth Account DB (PostgreSQL)]
    end
    AccountService[(Account Service)]
    TransactionService[(Transaction Service)]
    PaymentService[(Payment Service)]

    UI -- REST --> API
    API -- JDBC --> DB
    API -- HTTPS --> AccountService
    API -- HTTPS --> TransactionService
    API -- HTTPS --> PaymentService

    classDef external fill:#f9f,stroke:#333,stroke-width:2;
    AccountService,TransactionService,PaymentService:::external

    %% Notes:
    %% - API handles OAuth2, RBAC, Audit Logging
    %% - All integrations via secure REST
    %% - Compliance: GDPR, PCI-DSS, ISO27001