%% Sequence Diagram: Parent-Youth Account Management
sequenceDiagram
    participant Parent as Parent/Guardian
    participant WebUI as Web UI
    participant APIGW as API Gateway
    participant YAS as Youth Account Service
    participant SettingsDB as Settings DB
    participant CoreBanking as Core Banking System
    participant TransactionService as Transaction Ledger Service

    %% Dashboard retrieval
    Parent->>WebUI: Login & access dashboard
    WebUI->>APIGW: GET /api/youth-accounts/{id}/dashboard (OAuth2)
    APIGW->>YAS: Validate token, RBAC, forward request
    YAS->>CoreBanking: Fetch account balance
    YAS->>SettingsDB: Fetch spending limit
    YAS->>TransactionService: Fetch recent transactions
    YAS-->>APIGW: Dashboard data
    APIGW-->>WebUI: Dashboard data
    WebUI-->>Parent: Render dashboard

    %% Fund transfer
    Parent->>WebUI: Initiate fund transfer
    WebUI->>APIGW: POST /api/youth-accounts/{id}/fund-transfer (OAuth2)
    APIGW->>YAS: Validate, forward request
    YAS->>CoreBanking: Execute transfer
    YAS->>SettingsDB: Update balance/limit if needed
    YAS-->>APIGW: Transfer result
    APIGW-->>WebUI: Transfer result
    WebUI-->>Parent: Show transfer status

    %% Set spending limit
    Parent->>WebUI: Set new limit
    WebUI->>APIGW: PUT /api/youth-accounts/{id}/spending-limit (OAuth2)
    APIGW->>YAS: Validate, forward request
    YAS->>SettingsDB: Update weekly limit
    YAS-->>APIGW: Limit update status
    APIGW-->>WebUI: Limit update status
    WebUI-->>Parent: Show confirmation

    %% Transaction history
    Parent->>WebUI: View transaction history
    WebUI->>APIGW: GET /api/youth-accounts/{id}/transactions (OAuth2)
    APIGW->>YAS: Validate, forward request
    YAS->>TransactionService: Fetch history
    YAS-->>APIGW: Transaction history
    APIGW-->>WebUI: Transaction history
    WebUI-->>Parent: Show transactions