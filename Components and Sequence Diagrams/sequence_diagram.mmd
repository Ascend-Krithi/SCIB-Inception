%% Sequence Diagram: Parent manages youth account (Mermaid)
sequenceDiagram
  participant Parent as Parent/Guardian (Web)
  participant WebApp as Banking Web Application
  participant API as Youth Account API Gateway
  participant AccountSvc as Account Service
  participant TransSvc as Transaction Service
  participant PaymentSvc as Payment Service

  %% Dashboard load
  Parent->>WebApp: Login (OAuth2)
  WebApp->>API: GET /api/youth-accounts/{youthAccountId}/dashboard
  API->>AccountSvc: Fetch youth account data
  API->>TransSvc: Fetch recent transactions
  API-->>WebApp: Dashboard JSON
  WebApp-->>Parent: Render dashboard

  %% Fund transfer
  Parent->>WebApp: Initiate fund transfer
  WebApp->>API: POST /api/youth-accounts/{youthAccountId}/fund-transfer
  API->>PaymentSvc: Execute transfer
  PaymentSvc->>AccountSvc: Update balances
  PaymentSvc-->>API: Transfer result
  API-->>WebApp: Transfer confirmation
  WebApp-->>Parent: Show updated balance

  %% Set spending limit
  Parent->>WebApp: Set spending limit
  WebApp->>API: PUT /api/youth-accounts/{youthAccountId}/spending-limit
  API->>AccountSvc: Update limit
  API-->>WebApp: Limit confirmation
  WebApp-->>Parent: Show updated limit

  %% Fetch transactions
  Parent->>WebApp: View transactions
  WebApp->>API: GET /api/youth-accounts/{youthAccountId}/transactions
  API->>TransSvc: Query transactions
  TransSvc-->>API: Transactions JSON
  API-->>WebApp: Transaction list
  WebApp-->>Parent: Render transaction history
