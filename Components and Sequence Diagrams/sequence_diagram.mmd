%% Youth Account Management - Sequence Diagram (Mermaid)
sequenceDiagram
  participant Parent as Parent/Guardian
  participant WebApp as Web Frontend
  participant APIGW as API Gateway
  participant YthSvc as Youth Account Service
  participant AccSvc as Account Service
  participant TxnSvc as Transaction Service
  participant PaySvc as Payment Service
  participant SettingsDB as Settings DB

  %% Dashboard retrieval
  Parent->>WebApp: Login & select youth account
  WebApp->>APIGW: GET /api/youth-accounts/{id}/dashboard
  APIGW->>YthSvc: GET /dashboard
  YthSvc->>AccSvc: Get account balance
  AccSvc-->>YthSvc: Account balance
  YthSvc->>SettingsDB: Get spending limit
  SettingsDB-->>YthSvc: Spending limit
  YthSvc->>TxnSvc: Get recent transactions
  TxnSvc-->>YthSvc: Transactions
  YthSvc-->>APIGW: Dashboard data
  APIGW-->>WebApp: Dashboard data
  WebApp-->>Parent: Render dashboard

  %% Fund transfer
  Parent->>WebApp: Initiate fund transfer
  WebApp->>APIGW: POST /api/youth-accounts/{id}/fund-transfer
  APIGW->>YthSvc: Fund transfer request
  YthSvc->>AccSvc: Validate ownership & balance
  AccSvc-->>YthSvc: Validation OK
  YthSvc->>PaySvc: Transfer funds
  PaySvc-->>YthSvc: Transfer result
  YthSvc->>SettingsDB: Update balance
  SettingsDB-->>YthSvc: OK
  YthSvc-->>APIGW: Transfer response
  APIGW-->>WebApp: Transfer response
  WebApp-->>Parent: Show transfer status

  %% Set spending limit
  Parent->>WebApp: Set spending limit
  WebApp->>APIGW: PUT /api/youth-accounts/{id}/spending-limit
  APIGW->>YthSvc: Set limit request
  YthSvc->>SettingsDB: Update spending limit
  SettingsDB-->>YthSvc: OK
  YthSvc-->>APIGW: Limit updated
  APIGW-->>WebApp: Limit updated
  WebApp-->>Parent: Show confirmation

  %% Transaction history
  Parent->>WebApp: View transactions
  WebApp->>APIGW: GET /api/youth-accounts/{id}/transactions
  APIGW->>YthSvc: Get transactions
  YthSvc->>TxnSvc: Query transactions
  TxnSvc-->>YthSvc: Transaction list
  YthSvc-->>APIGW: Transactions
  APIGW-->>WebApp: Transactions
  WebApp-->>Parent: Display history