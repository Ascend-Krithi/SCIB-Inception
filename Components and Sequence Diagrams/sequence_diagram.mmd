%% Sequence Diagram for Youth Account Management API (Mermaid)
sequenceDiagram
  participant Parent
  participant UI as Web UI
  participant API as Youth Account Management API
  participant Account as Account Service
  participant Transaction as Transaction Service
  participant Payment as Payment Service

  %% Dashboard retrieval
  Parent->>UI: Login & View Dashboard
  UI->>API: GET /api/youth-accounts/{youthAccountId}/dashboard (OAuth2)
  API->>Account: GET account info (REST)
  API->>Transaction: GET recent transactions (REST)
  API-->>UI: Dashboard data (balance, limits, transactions)
  UI-->>Parent: Display dashboard

  %% Fund transfer
  Parent->>UI: Initiate fund transfer
  UI->>API: POST /api/youth-accounts/{youthAccountId}/fund-transfer (OAuth2)
  API->>Payment: Initiate transfer (REST)
  Payment-->>API: Transfer result
  API-->>UI: Transfer confirmation (status, updatedBalance)
  UI-->>Parent: Show result

  %% Set spending limit
  Parent->>UI: Set weekly spending limit
  UI->>API: PUT /api/youth-accounts/{youthAccountId}/spending-limit (OAuth2)
  API-->>UI: Limit update result
  UI-->>Parent: Show confirmation

  %% Transaction history
  Parent->>UI: View transactions
  UI->>API: GET /api/youth-accounts/{youthAccountId}/transactions (OAuth2)
  API->>Transaction: Fetch history (REST)
  API-->>UI: Transaction history
  UI-->>Parent: Display history
