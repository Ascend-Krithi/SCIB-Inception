%% Sequence Diagram for Youth Account Management API (Mermaid)
sequenceDiagram
  participant Parent as Parent/Guardian
  participant UI as Web UI (React)
  participant API as Youth Account API (Spring Boot)
  participant Account as Account Service
  participant Payment as Payment Service
  participant Transaction as Transaction Service
  participant DB as Youth Account DB

  %% Dashboard Retrieval
  Parent->>UI: Open Dashboard
  UI->>API: GET /api/youth-accounts/{id}/dashboard
  API->>Account: Get Account Details
  API->>DB: Get Spending Limit
  API->>Transaction: Get Recent Transactions
  API-->>UI: Dashboard JSON
  UI-->>Parent: Render Dashboard

  %% Fund Transfer
  Parent->>UI: Initiate Fund Transfer
  UI->>API: POST /api/youth-accounts/{id}/fund-transfer
  API->>Payment: Transfer Funds
  Payment-->>API: Transfer Result
  API->>DB: Update Account Balance
  API-->>UI: Transfer Response
  UI-->>Parent: Show Transfer Status

  %% Set Spending Limit
  Parent->>UI: Set Spending Limit
  UI->>API: PUT /api/youth-accounts/{id}/spending-limit
  API->>DB: Update Limit
  API-->>UI: Limit Updated
  UI-->>Parent: Show Limit

  %% Transaction History
  Parent->>UI: View Transactions
  UI->>API: GET /api/youth-accounts/{id}/transactions
  API->>Transaction: Get Transactions
  Transaction-->>API: Transactions Data
  API-->>UI: Transactions Response
  UI-->>Parent: Show Transactions
