%% Sequence Diagram: Parent Allocates Funds, Sets Limit, Views Dashboard & Transactions
sequenceDiagram
  autonumber
  participant Parent as Parent/Guardian
  participant UI as Parent Dashboard UI
  participant API as Youth Account API
  participant Auth as OAuth2 Service
  participant Account as Account Service
  participant Payment as Payment Service
  participant Transaction as Transaction Service
  participant DB as Database

  %% Dashboard Access
  Parent->>UI: Login & select youth account
  UI->>Auth: Validate OAuth2 token
  Auth-->>UI: Token valid (RBAC: Parent)
  UI->>API: GET /api/youth-accounts/{id}/dashboard
  API->>Account: Fetch youth account details
  API->>Transaction: Fetch recent transactions
  Account-->>API: Account details
  Transaction-->>API: Recent transactions
  API-->>UI: Dashboard data
  UI-->>Parent: Render dashboard

  %% Fund Transfer
  Parent->>UI: Initiate fund transfer
  UI->>API: POST /api/youth-accounts/{id}/fund-transfer
  API->>Auth: Validate RBAC/ownership
  Auth-->>API: Authorized
  API->>Account: Check parent balance
  Account-->>API: Balance OK
  API->>Payment: Execute fund transfer
  Payment-->>API: TransferId, status
  API->>DB: Update youth account balance
  API-->>UI: Transfer confirmation
  UI-->>Parent: Show updated balance/status

  %% Set Spending Limit
  Parent->>UI: Set weekly spending limit
  UI->>API: PUT /api/youth-accounts/{id}/spending-limit
  API->>Auth: Validate RBAC/ownership
  Auth-->>API: Authorized
  API->>DB: Update weekly_spending_limit
  API-->>UI: Limit updated
  UI-->>Parent: Show confirmation

  %% View Transactions
  Parent->>UI: View transaction history
  UI->>API: GET /api/youth-accounts/{id}/transactions
  API->>Auth: Validate RBAC/ownership
  Auth-->>API: Authorized
  API->>Transaction: Query transactions
  Transaction-->>API: Transaction list
  API-->>UI: Paginated transactions
  UI-->>Parent: Display transaction list
