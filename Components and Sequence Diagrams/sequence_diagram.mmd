%% Sequence Diagram for Youth Account Management (Mermaid)
sequenceDiagram
    participant Parent as Parent/Guardian
    participant WebApp as Banking Web Application
    participant APIGW as API Gateway
    participant YAS as Youth Account Service
    participant PaySvc as Payment Service
    participant TxnSvc as Transaction Service

    %% Dashboard Retrieval
    Parent->>WebApp: Login & select youth dashboard
    WebApp->>APIGW: GET /api/youth-accounts/{youthAccountId}/dashboard (OAuth/JWT)
    APIGW->>YAS: Forward request (RBAC enforced)
    YAS-->>APIGW: Dashboard data (balance, limit, recent txns)
    APIGW-->>WebApp: Dashboard data
    WebApp-->>Parent: Display dashboard

    %% Fund Transfer
    Parent->>WebApp: Initiate fund transfer
    WebApp->>APIGW: POST /api/youth-accounts/{youthAccountId}/fund-transfer
    APIGW->>YAS: Forward request (validate)
    YAS->>PaySvc: Initiate fund transfer
    PaySvc-->>YAS: Transfer status
    YAS-->>APIGW: Transfer response (updated balance)
    APIGW-->>WebApp: Transfer response
    WebApp-->>Parent: Display result

    %% Set Spending Limit
    Parent->>WebApp: Set weekly spending limit
    WebApp->>APIGW: PUT /api/youth-accounts/{youthAccountId}/spending-limit
    APIGW->>YAS: Forward request (RBAC enforced)
    YAS-->>APIGW: Limit update confirmation
    APIGW-->>WebApp: Confirmation
    WebApp-->>Parent: Display confirmation

    %% Transaction History
    Parent->>WebApp: View transactions
    WebApp->>APIGW: GET /api/youth-accounts/{youthAccountId}/transactions
    APIGW->>YAS: Forward request
    YAS->>TxnSvc: Retrieve transactions
    TxnSvc-->>YAS: Transaction list
    YAS-->>APIGW: Transaction history
    APIGW-->>WebApp: Transaction history
    WebApp-->>Parent: Display transactions
