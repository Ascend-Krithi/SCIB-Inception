%% Sequence Diagram for Youth Account Management (Mermaid)
sequenceDiagram
    participant Parent as Parent/Guardian
    participant WebApp as Web/Mobile App
    participant APIGW as API Gateway
    participant YAS as Youth Account Service
    participant PaySvc as Payment Service
    participant TxnSvc as Transaction Service
    participant DB as Database

    %% Dashboard Retrieval
    Parent->>WebApp: Login & request dashboard
    WebApp->>APIGW: GET /api/youth-accounts/{id}/dashboard (OAuth)
    APIGW->>YAS: Forward request (RBAC, AuthN)
    YAS->>DB: Query account, settings
    YAS->>TxnSvc: Fetch recent transactions
    TxnSvc->>DB: Query transactions
    TxnSvc-->>YAS: Transaction list
    YAS-->>APIGW: Dashboard data
    APIGW-->>WebApp: Dashboard data
    WebApp-->>Parent: Render dashboard

    %% Fund Transfer
    Parent->>WebApp: Initiate fund transfer
    WebApp->>APIGW: POST /api/youth-accounts/{id}/fund-transfer
    APIGW->>YAS: Forward request (RBAC, AuthN)
    YAS->>PaySvc: Transfer funds
    PaySvc->>DB: Update balances
    PaySvc-->>YAS: Transfer status
    YAS->>DB: Update youth account balance
    YAS-->>APIGW: Transfer result
    APIGW-->>WebApp: Transfer result
    WebApp-->>Parent: Show confirmation

    %% Set Spending Limit
    Parent->>WebApp: Set weekly spending limit
    WebApp->>APIGW: PUT /api/youth-accounts/{id}/spending-limit
    APIGW->>YAS: Forward request (RBAC, AuthN)
    YAS->>DB: Update settings
    YAS-->>APIGW: Limit updated
    APIGW-->>WebApp: Limit updated
    WebApp-->>Parent: Show confirmation

    %% Retrieve Transaction History
    Parent->>WebApp: View transaction history
    WebApp->>APIGW: GET /api/youth-accounts/{id}/transactions
    APIGW->>YAS: Forward request (RBAC, AuthN)
    YAS->>TxnSvc: Get transactions
    TxnSvc->>DB: Query transactions
    TxnSvc-->>YAS: Transaction data
    YAS-->>APIGW: Transaction history
    APIGW-->>WebApp: Transaction history
    WebApp-->>Parent: Display history